<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!--
      Gates CpuComService / VehicleCoordinationService (signatureOrSystem). Granting it
      requires the app to run privileged: platform-signed, or installed to /system/priv-app
      on a rooted unit (see reference-docs/can-analysis.md §6.2). With it, the app binds
      CpuComService directly and receives the raw FCAN/BCAN frame stream (real CAN id + byte[8])
      that the companion MCU forwards, plus the requestFcan/BcanReceiveData subscription API.
    -->
    <uses-permission android:name="com.mitsubishielectric.ada.permission.VEHICLE_RW"/>

    <application
        android:label="Clusters"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".ClusterDisplayService"
            android:exported="false"/>

    </application>

</manifest>
